{
  "title": "Job Queue",
  "uid": "job-queue",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Queue depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "queue_pending_jobs", "legendFormat": "pending" },
        { "expr": "queue_running_jobs", "legendFormat": "running" }
      ]
    },
    {
      "id": 2,
      "title": "Throughput (jobs/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rate(jobs_enqueued_total[1m])", "legendFormat": "enqueued" },
        { "expr": "rate(jobs_completed_total[1m])", "legendFormat": "completed" },
        { "expr": "rate(jobs_failed_total[1m])", "legendFormat": "failed" },
        { "expr": "rate(jobs_dead_lettered_total[1m])", "legendFormat": "dead-lettered" }
      ]
    },
    {
      "id": 3,
      "title": "Failure rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(jobs_failed_total[5m]) / (rate(jobs_completed_total[5m]) + rate(jobs_failed_total[5m]))",
          "legendFormat": "failure ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "Job processing duration (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(job_processing_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(job_processing_duration_seconds_bucket[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(job_processing_duration_seconds_bucket[5m]))", "legendFormat": "p99" }
      ]
    }
  ]
}
